# Public site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sanity project (shared with Studio)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-08-02

# Draft Mode / Visual Editing (server-only — never expose to the browser)
SANITY_API_READ_TOKEN=
SANITY_VIEWER_TOKEN=

# On-demand revalidation webhook (Sanity → POST /api/revalidate)
# Create in sanity.io/manage → API → Webhooks; use the same secret as the webhook
SANITY_REVALIDATE_SECRET=

# Migration writes only (never expose to the browser)
SANITY_API_WRITE_TOKEN=

# Cloudflare R2 image CDN (serve site images from R2 instead of Sanity CDN)
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-a58c74b60c3c4a939d9922078fb2fe76.r2.dev
R2_ACCOUNT_ID=24a14818920ba9e070fd483f79b98c82
R2_BUCKET_NAME=polumatkimya
# Create an R2 API token with Object Read & Write for this bucket
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Cloudflare Stream (optional — needed when only video UID is stored in Sanity)
# From Stream dashboard: customer-<CODE>.cloudflarestream.com → use CODE only
NEXT_PUBLIC_CLOUDFLARE_STREAM_CUSTOMER_CODE=

# Resend (contact / quote forms)
RESEND_API_KEY=
RESEND_FROM=Polumat Kimya <noreply@polumatkimya.com>
# Test inbox — later: info@polumatkimya.com
CONTACT_TO_EMAIL=gidenbedirhan98@gmail.com
