{
  "name": "polumatkimya.com",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "studio"
  ],
  "scripts": {
    "dev": "next dev",
    "dev:studio": "bun run --filter polumat-studio dev",
    "build": "next build",
    "build:studio": "bun run --filter polumat-studio build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "typecheck:studio": "bun run --filter polumat-studio typecheck",
    "schema:extract": "bun run --filter polumat-studio schema:extract",
    "typegen": "bun run --filter polumat-studio typegen",
    "migrate:extract": "tsx migration/scripts/extract.ts",
    "migrate:transform": "tsx migration/scripts/transform.ts",
    "migrate:validate": "tsx migration/scripts/validate.ts",
    "migrate:import": "tsx migration/scripts/import.ts",
    "fix:grout-filler": "tsx migration/scripts/fix-grout-filler-product.ts",
    "seed:export-page": "tsx migration/scripts/seed-export-page.ts",
    "seed:turkey-sales-page": "tsx migration/scripts/seed-turkey-sales-page.ts",
    "seed:contact-page": "tsx migration/scripts/seed-contact-page.ts",
    "migrate:spec-i18n": "tsx migration/scripts/migrate-spec-value-unit-i18n.ts",
    "enrich:catalog": "tsx migration/scripts/enrich-products-from-catalog.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@sanity/client": "^7.20.0",
    "@sanity/document-internationalization": "^6.2.27",
    "@sanity/icons": "^3.7.4",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^5.31.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "maplibre-gl": "^6",
    "next": "^16.3.4",
    "next-sanity": "^11.6.13",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.28.1",
    "sanity": "^5.14.1",
    "sanity-plugin-internationalized-array": "^5.1.24",
    "styled-components": "^6.4.4",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "tsx": "^4.20.5",
    "typescript": "^5"
  }
}
